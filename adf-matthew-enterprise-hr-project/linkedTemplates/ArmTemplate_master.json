{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-matthew-enterprise-hr-project"
		},
		"LS_ADLS_RawEnterpriseHRFiles_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_RawEnterpriseHRFiles'"
		},
		"LS_DB_RawEnterpriseHRFiles_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'LS_DB_RawEnterpriseHRFiles'"
		},
		"LS_ADLS_RawEnterpriseHRFiles_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dlmkenterprisehrstorage.dfs.core.windows.net/"
		},
		"LS_DB_RawEnterpriseHRFiles_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0320-025736-qgd67nh4"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-matthew-enterprise-hr-project_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_RawEnterpriseHRFiles_accountKey": {
						"value": "[parameters('LS_ADLS_RawEnterpriseHRFiles_accountKey')]"
					},
					"LS_DB_RawEnterpriseHRFiles_accessToken": {
						"value": "[parameters('LS_DB_RawEnterpriseHRFiles_accessToken')]"
					},
					"LS_ADLS_RawEnterpriseHRFiles_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_RawEnterpriseHRFiles_properties_typeProperties_url')]"
					},
					"LS_DB_RawEnterpriseHRFiles_properties_typeProperties_existingClusterId": {
						"value": "[parameters('LS_DB_RawEnterpriseHRFiles_properties_typeProperties_existingClusterId')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adf-matthew-enterprise-hr-project_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-matthew-enterprise-hr-project_ArmTemplate_0')]"
			]
		}
	]
}